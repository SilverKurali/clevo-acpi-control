_LANG = "en"


def dwidth(text):
    """终端显示宽度：CJK 全角字符占 2 列。"""
    import unicodedata
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in text)


def pad(text, width):
    return text + " " * max(0, width - dwidth(text))


def detect_lang():
    override = os.environ.get("CLEVO_LANG", "").lower()
    if override in ("zh", "en"):
        return override
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")
        if v:
            return "zh" if v.lower().startswith("zh") else "en"
    return "en"


def T(key, *args):
    s = S.get(_LANG, S["en"]).get(key, S["en"].get(key, key))
    return s.format(*args) if args else s


class AcpiError(Exception):
    pass


def detect_model():
    try:
        with open("/sys/class/dmi/id/product_name") as f:
            return f.read().strip()
    except OSError:
        return ""


def model_supported(model):
    return any(model.upper().startswith(m) for m in SUPPORTED_MODELS)


def need_root():
    if os.geteuid() != 0:
        sys.exit(T("need_root", " ".join(sys.argv)))


def acpi_call(path, *args):
    if not os.path.exists(ACPI_CALL):
        raise AcpiError(T("no_acpi", ACPI_CALL))
    expr = "%s %s" % (path, " ".join(str(a) for a in args))
    try:
        with open(ACPI_CALL, "w") as f:
            f.write(expr)
        with open(ACPI_CALL) as f:
            return f.read().strip()
    except OSError as e:
        raise AcpiError(T("write_fail", ACPI_CALL, e))


def parse_int(raw):
    """Extract the integer result from /proc/acpi/call.

    The buffer format is "<result>\\0called\\0" - the tail is leftover text from a
    previous write. It MUST be cut at the first NUL, otherwise hex-legal letters
    inside "called" get appended to the value (0x21C read as 0x21).
    """
    val = raw.split("\x00")[0].strip()
    m = re.match(r"^0x([0-9a-fA-F]+)$", val)
    if m:
        return int(m.group(1), 16)
    m = re.match(r"^(\d+)$", val)
    if m:
        return int(m.group(1))
    return None


def read_var(path):
    try:
        return parse_int(acpi_call(path))
    except AcpiError:
        return None


def detect_scmd():
    for path in SCMD_CANDIDATES:
        raw = acpi_call(path, 0, PROBE_CMD, 0)
        if parse_int(raw) == PROBE_CMD:
            return path, raw
    raise AcpiError(T("no_scmd"))


def read_psf4():
    for base in ("\\_SB.WMI", "\\_SB.DCHU"):
        try:
            return parse_int(acpi_call(base + ".GCMD", 0, CMD_GET_PSF4, 0))
        except AcpiError:
            continue
    return None


def decode_ntcf(ntcf):
    out = []
    for shift, name, desc_en, desc_zh in NTCF_FIELDS:
        nib = (ntcf >> shift) & 0xF
        modes = [MODE_BY_ID[b] for b in range(4) if (nib >> b) & 1]
        desc = desc_en if _LANG == "en" else desc_zh
        out.append((name, desc, nib, modes))
    return out


# ─────────────────────────── commands ───────────────────────────
def cmd_status(args):
    need_root()
    print("clevo-acpi-control — status\n" if _LANG == "en" else "clevo-acpi-control — 状态\n")

    model = detect_model()
    ok = model_supported(model)
    print("  %s: %s  %s" % (pad(T("model"), 16), model or "?",
          T("supported") if ok else T("unsupported")))

    path, _ = detect_scmd()
    print("  %s: %s" % (pad(T("scmd"), 16), path))

    psf4 = read_psf4()
    if psf4 is None:
        print("  %s: %s" % (pad(T("psf4"), 16), T("psf4_fail")))
        gate = None
    else:
        gate = bool(psf4 & 0x04)
        print("  %s: 0x%08X" % (pad(T("psf4"), 16), psf4))
        print("  %s: %s" % (pad(T("gate"), 16), T("gate_on") if gate else T("gate_off")))

    cpcm = read_var(VARS["CPCM"])
    if cpcm is None:
        print("\n  %s: %s" % (pad(T("cur"), 16), T("read_fail")))
    else:
        name = MODE_BY_ID.get(cpcm, "?")
        label = MODES.get(name, (None, "?", "?"))[1 if _LANG == "en" else 2]
        shown = name if name == label else "%s / %s" % (name, label)
        print("\n  %s: %d (%s)" % (pad(T("cur"), 16), cpcm, shown))

    ntcf = read_var(VARS["NTCF"])
    if ntcf is not None:
        print("  %s: 0x%04X" % (pad(T("ntcf"), 16), ntcf))
        print("\n  %s" % T("what_each"))
        for name, desc, nib, modes in decode_ntcf(ntcf):
            shown = ", ".join(modes) if modes else T("none")
            print("    %-6s %-18s %s 0x%X → %s" % (name, desc, T("mask"), nib, shown))

    print("\n  %s" % T("gpu_auth"))
    for key in ("CTGP", "DTGP", "DBAC", "DBDC"):
        v = read_var(VARS[key])
        if v is None:
            mark = T("read_failed")
        elif v:
            mark = "OK  " + T("authorized")
        else:
            mark = "--  " + T("not_authorized")
        print("    %-6s = %-6s %s" % (key, "?" if v is None else "0x%X" % v, mark))

    print("\n  " + "-" * 46)
    if gate is False:
        print("  " + T("v_off1"))
        for k in ("v_off2", "v_off3", "v_off4"):
            print("  " + T(k))
    elif gate is True:
        print("  " + T("v_on1"))
        print("  " + T("v_on2", sys.argv[0]))
    if ntcf is not None and cpcm is not None:
        want = ((ntcf >> 0) & 0xF) >> cpcm & 1
        have = read_var(VARS["CTGP"])
        if want and have == 0:
            print("  !  " + T("inconsistent"))
        elif want and have:
            print("  +  " + T("ctgp_ok"))
    print("  " + "-" * 46)
    return 0


def cmd_set(args):
    need_root()
    if args.mode not in MODES:
        sys.exit(T("bad_mode", args.mode, ", ".join(MODES)))
    mid = MODES[args.mode][0]

    model = detect_model()
    if not model_supported(model) and not args.force:
        sys.exit(T("model_warn", model or "?"))

    path, raw = detect_scmd()
    print("%s: %s" % (T("model"), model or "?"))
    print("%s: %s  (probe %s)" % (T("scmd"), path, raw) if _LANG == "en"
          else "%s: %s  (探针 %s)" % (T("scmd"), path, raw))

    psf4 = read_psf4()
    if psf4 is not None:
        print("%s: 0x%08X   %s %s" % (T("psf4"), psf4, T("gate"),
              T("gate_on") if psf4 & 0x04 else T("gate_off")))
        if not (psf4 & 0x04) and not args.force:
            sys.exit("\n" + T("gate_off") + "  (use --force to try anyway)")

    args_val = (SUB_SET_MODE << 24) | mid
    label = MODES[args.mode][1 if _LANG == "en" else 2]
    print("\n%s: %s 0 0x%02X 0x%08X   (%s / %s)" %
          (T("will_run"), path, CMD_EXT, args_val, args.mode, label))
    if args.dry_run:
        print(T("dry_run"))
        return 0

    result = acpi_call(path, 0, CMD_EXT, args_val)
    print("%s: %s" % (T("ret"), result))

    if parse_int(result) == 0xFFFFFFFFFFFFFFFF:
        print("\n" + T("ones1"))
        for k in ("ones2", "ones3", "ones4"):
            print(T(k))
        return 1

    print("\n" + T("ok1"))
    for k in ("ok2", "ok3", "ok4"):
        print(T(k))
    return 0


def cmd_probe(args):
    need_root()
    path, _ = detect_scmd()
    print("%s: %s\n" % (T("scmd"), path))
    print(T("probe_hdr") + "\n")
    for cid in (0x13, 0x14, 0x1D, 0x1F, 0x52, 0x60, 0x7A):
        for base in ("\\_SB.WMI", "\\_SB.DCHU"):
            try:
                raw = acpi_call(base + ".GCMD", 0, cid, 0)
                print("  %-10s GCMD 0x%02X → %s" % (base.split(".")[-1], cid, raw))
            except AcpiError:
                break
    return 0


def main():
    global _LANG
    ap = argparse.ArgumentParser(
        description="Control Clevo/Tongfang laptop performance profiles via ACPI",
        epilog="Example: sudo %(prog)s status | sudo %(prog)s set performance")
    ap.add_argument("--lang", choices=["zh", "en"], help="UI language (default: from locale)")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("status", help="show current state (read-only)")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("set", help="set performance profile")
    p.add_argument("mode", help="quiet | saving | performance | entertainment")
    p.add_argument("--dry-run", action="store_true", help="show what would run")
    p.add_argument("--force", action="store_true", help="attempt even if the model is unsupported")
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("probe", help="read-only probe of all known commands")
    p.set_defaults(func=cmd_probe)

    args = ap.parse_args()
    _LANG = args.lang or detect_lang()
    if not getattr(args, "func", None):
        ap.print_help()
        return 1
    try:
        return args.func(args)
    except AcpiError as e:
        sys.exit(str(e))


if __name__ == "__main__":
    sys.exit(main())
