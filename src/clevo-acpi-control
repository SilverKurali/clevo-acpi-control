#!/usr/bin/env python3
"""
clevo-acpi-control — control Clevo/Tongfang laptop performance profiles via ACPI.

Uses the vendor's own ACPI interface (\\_SB.WMI.SCMD, command 0x79 / sub-command 0x19),
the same path the Windows Control Center uses. No firmware flashing, no vBIOS patching.

Protocol details: docs/PROTOCOL.md
"""

import os
import re
import sys
import argparse

ACPI_CALL = "/proc/acpi/call"

# Candidate SCMD paths, tried in order
SCMD_CANDIDATES = ["\\_SB.WMI.SCMD", "\\_SB.DCHU.SCMD"]

# Known-good read-only probe command (returns its own number)
PROBE_CMD = 0x14

# Command 0x79 is the extended-command entry point:
#   ARGS = (sub_command << 24) | data
CMD_EXT = 0x79
SUB_SET_MODE = 0x19
CMD_GET_PSF4 = 0x60

MODES = {
    "quiet":         (0, "quiet",         "安静"),
    "saving":        (1, "saving",        "省电"),
    "performance":   (2, "performance",   "性能"),
    "entertainment": (3, "entertainment", "娱乐"),
}
MODE_BY_ID = {v[0]: k for k, v in MODES.items()}

# Known-supported models (DMI product_name prefix)
SUPPORTED_MODELS = ("P15", "P16")

# Read-only ACPI variables
VARS = {
    "CPCM": "\\_SB.PC00.LPCB.EC.CPCM",
    "NTCF": "\\_SB.PC00.PEG1.PEGP.NTCF",
    "CTGP": "\\_SB.NPCF.CTGP",
    "DTGP": "\\_SB.NPCF.DTGP",
    "DBAC": "\\_SB.NPCF.DBAC",
    "DBDC": "\\_SB.NPCF.DBDC",
}

NTCF_FIELDS = [
    (0,  "CTGP", "base TGP raise",    "基础 TGP 提升"),
    (4,  "DTGP", "Dynamic Boost",     "Dynamic Boost"),
    (8,  "DBAC", "DB on AC",          "DB 交流"),
    (12, "DBDC", "DB on DC",          "DB 直流"),
]

